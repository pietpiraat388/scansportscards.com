---
import { guides, relatedByPath } from '../data';

interface Props {
  current: string;
}

const { current } = Astro.props;

const byPath = Object.fromEntries(guides.map((g) => [g.path, g]));
const picks = (relatedByPath[current] ?? guides.filter((g) => g.path !== current).slice(0, 3).map((g) => g.path))
  .map((path) => byPath[path])
  .filter(Boolean);
---

<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Keep reading</p>
      <h2>More collector guides</h2>
    </div>
    <div class="grid grid--3">
      {
        picks.map((g) => (
          <a class="guide-card" href={g.path}>
            <img
              class="guide-card__image"
              src={g.featureImage.src}
              alt={g.featureImage.alt}
              width={g.featureImage.width}
              height={g.featureImage.height}
              loading="lazy"
            />
            <span class="eyebrow">{g.tag}</span>
            <h3>{g.cardTitle}</h3>
            <p>{g.cardText}</p>
            <span class="more">Read the guide</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
