---
import { APP_STORE_URL } from '../lib/site';
---

<a href={APP_STORE_URL} rel="noopener" aria-label="Download CardSense on the App Store" class="appstore-badge">
  <svg viewBox="0 0 180 60" width="180" height="60" role="img" aria-hidden="true">
    <rect x="1" y="1" width="178" height="58" rx="12" fill="#000" stroke="#a6a6a6" stroke-width="1" />
    <g fill="#fff">
      <path d="M36.9 30.6c0-3.6 3-5.4 3.1-5.5-1.7-2.5-4.3-2.8-5.3-2.8-2.2-.2-4.4 1.3-5.5 1.3-1.1 0-2.9-1.3-4.8-1.3-2.4 0-4.7 1.4-6 3.6-2.6 4.4-.7 11 1.8 14.6 1.2 1.8 2.7 3.7 4.6 3.7 1.8-.1 2.5-1.2 4.8-1.2 2.2 0 2.9 1.2 4.8 1.1 2 0 3.2-1.8 4.4-3.6 1.4-2 2-4 2-4.1-.1 0-3.9-1.5-3.9-5.8zM33.3 19.9c1-1.2 1.7-2.9 1.5-4.6-1.4.1-3.2 1-4.2 2.2-.9 1.1-1.7 2.8-1.5 4.4 1.6.2 3.1-.8 4.2-2z" />
      <text x="56" y="24" font-family="-apple-system, 'Helvetica Neue', Arial, sans-serif" font-size="11" letter-spacing="0.3">Download on the</text>
      <text x="56" y="44" font-family="-apple-system, 'Helvetica Neue', Arial, sans-serif" font-size="19" font-weight="600">App Store</text>
    </g>
  </svg>
</a>

<style>
  .appstore-badge {
    display: inline-block;
    line-height: 0;
    border-radius: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .appstore-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(10, 26, 51, 0.25);
  }
  .appstore-badge svg {
    display: block;
  }
</style>
