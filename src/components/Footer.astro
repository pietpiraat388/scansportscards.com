---
import { Image } from 'astro:assets';
import icon from '../assets/app-icon.png';
import { APP_STORE_URL } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="brand">
          <Image src={icon} alt="" width={64} height={64} format="webp" />
          CardSense
        </a>
        <p>
          CardSense is an AI sports card scanner for iPhone. Snap a photo of any baseball,
          basketball, football, hockey, or soccer card to identify it and see its estimated
          market value based on recent eBay sales.
        </p>
      </div>
      <nav aria-label="Guides">
        <h4>Guides</h4>
        <ul>
          <li><a href="/sports-card-value">Sports card value</a></li>
          <li><a href="/sports-card-prices">Sports card prices</a></li>
          <li><a href="/sports-card-worth">What are my cards worth?</a></li>
          <li><a href="/sports-card-grading">Sports card grading</a></li>
        </ul>
      </nav>
      <nav aria-label="Card values by sport">
        <h4>By sport</h4>
        <ul>
          <li><a href="/baseball-card-values">Baseball card values</a></li>
          <li><a href="/basketball-card-values">Basketball card values</a></li>
          <li><a href="/football-card-values">Football card values</a></li>
          <li><a href="/hockey-card-values">Hockey card values</a></li>
          <li><a href="/soccer-card-values">Soccer card values</a></li>
        </ul>
      </nav>
      <nav aria-label="App">
        <h4>App</h4>
        <ul>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href={APP_STORE_URL} rel="noopener">Download on the App Store</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__legal">
      <span>© {year} CardSense. All rights reserved.</span>
      <span>Made for collectors of sports cards everywhere.</span>
    </div>
  </div>
</footer>
