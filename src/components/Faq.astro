---
import type { FaqEntry } from '../data';

interface Props {
  faqs: FaqEntry[];
}

const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div>
          {f.a.split('\n\n').map((p) => (
            <p>{p}</p>
          ))}
          {f.learnMore ? (
            <p>
              <a href={f.learnMore.href}>{f.learnMore.label}</a>
            </p>
          ) : null}
        </div>
      </details>
    ))
  }
</div>
