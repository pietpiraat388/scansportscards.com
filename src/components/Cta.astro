---
import AppStoreBadge from './AppStoreBadge.astro';
import { home } from '../data';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = home.cta.title,
  text = home.cta.text,
} = Astro.props;
---

<section class="section section--ink cta-band">
  <div class="wrap">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta-band__actions">
      <AppStoreBadge />
    </div>
    <p class="cta-band__note">{home.cta.note}</p>
  </div>
</section>
