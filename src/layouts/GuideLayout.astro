---
import BaseLayout from './BaseLayout.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import {
  articleSchema,
  breadcrumbSchema,
  faqSchema,
  type FaqEntry,
} from '../lib/site';

interface Props {
  title: string;
  metaTitle: string;
  metaDescription: string;
  path: string;
  eyebrow: string;
  lede: string;
  faqs: FaqEntry[];
  faqTitle?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  metaTitle,
  metaDescription,
  path,
  eyebrow,
  lede,
  faqs,
  faqTitle = 'Frequently asked questions',
  datePublished = '2026-07-12',
  dateModified = '2026-07-12',
} = Astro.props;

const schema = [
  articleSchema({ title, description: metaDescription, path, datePublished, dateModified }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: title, path },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  path={path}
  ogImage={`/og${path}.png`}
  schema={schema}
>
  <article>
    <header class="article-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{lede}</p>
      </div>
    </header>

    <div class="section">
      <div class="wrap">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    <section class="section section--tint" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">{faqTitle}</h2>
        </div>
        <Faq faqs={faqs} />
      </div>
    </section>
  </article>

  <RelatedGuides current={path} />
  <Cta />
</BaseLayout>
