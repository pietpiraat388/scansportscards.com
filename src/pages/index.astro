---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { homeJsonLd } from '../lib/site';
import { home, homeFaqs, screenshots, homeGuideCards } from '../data';

import shot1 from '../assets/screenshot-1.png';
import shot2 from '../assets/screenshot-2.png';
import shot3 from '../assets/screenshot-3.png';
import shot4 from '../assets/screenshot-4.png';
import shot5 from '../assets/screenshot-5.png';
import shot6 from '../assets/screenshot-6.png';
import shot7 from '../assets/screenshot-7.png';
import shot8 from '../assets/screenshot-8.png';

const shots = { 1: shot1, 2: shot2, 3: shot3, 4: shot4, 5: shot5, 6: shot6, 7: shot7, 8: shot8 };
const gallery = screenshots.map((s) => ({ ...s, img: shots[s.id as keyof typeof shots] }));
const guideCards = homeGuideCards();
---

<BaseLayout title={home.title} description={home.description} path="" schema={homeJsonLd()}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div>
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>
          {home.hero.h1Before}<span class="pill">{home.hero.h1Pill}</span>{home.hero.h1After}
        </h1>
        <p class="hero__lede">{home.hero.lede}</p>
        <div class="hero__actions">
          <AppStoreBadge />
          <a href="#how-it-works" class="btn btn--ghost">See how it works</a>
        </div>
        <p class="hero__note">{home.hero.note}</p>
        <div class="hero__stats">
          {
            home.hero.stats.map((s) => (
              <div class="hero__stat">
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="hero__phone">
        <div class="scan-stage">
          <div class="phone">
            <Image
              src={shot2}
              alt="Confirm Card screen with a 1986 Fleer Michael Jordan card ready for identification"
              width={640}
              widths={[320, 480, 640]}
              sizes="(max-width: 56rem) 78vw, 21rem"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section download-band" id="download">
    <div class="wrap download-band__inner">
      <div>
        <p class="eyebrow">{home.download.eyebrow}</p>
        <h2>{home.download.h2}</h2>
        <p>{home.download.text}</p>
        <p class="download-band__note">{home.download.note}</p>
      </div>
      <AppStoreBadge />
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.how.eyebrow}</p>
        <h2>{home.how.h2}</h2>
        <p>{home.how.lede}</p>
      </div>
      <div class="steps">
        {
          home.how.steps.map((step) => (
            <div class="step">
              <h3>{step.h3}</h3>
              <p>{step.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{home.prices.eyebrow}</p>
        <h2>{home.prices.h2}</h2>
        <p>{home.prices.lede}</p>
        <ul>
          {home.prices.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <p>
          New to reading card prices? Start with our <a href={home.prices.moreHref}>{home.prices.moreLabel}</a>.
        </p>
      </div>
      <div class="scan-stage">
        <div class="phone">
          <Image
            src={shot4}
            alt={screenshots[3].alt}
            width={640}
            widths={[320, 480, 640]}
            sizes="(max-width: 56rem) 78vw, 21rem"
            format="webp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--flip">
      <div class="scan-stage">
        <div class="phone">
          <Image
            src={shot5}
            alt={screenshots[4].alt}
            width={640}
            widths={[320, 480, 640]}
            sizes="(max-width: 56rem) 78vw, 21rem"
            format="webp"
          />
        </div>
      </div>
      <div>
        <p class="eyebrow">{home.collection.eyebrow}</p>
        <h2>{home.collection.h2}</h2>
        <p>{home.collection.lede}</p>
        <ul>
          {home.collection.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="screenshots">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.screenshots.eyebrow}</p>
        <h2>{home.screenshots.h2}</h2>
        <p>{home.screenshots.lede}</p>
      </div>
      <div class="gallery">
        {
          gallery.map((g) => (
            <figure>
              <Image
                src={g.img}
                alt={g.alt}
                width={512}
                widths={[256, 512]}
                sizes="(max-width: 40rem) 62vw, 16rem"
                format="webp"
              />
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.features.eyebrow}</p>
        <h2>{home.features.h2}</h2>
        <p>{home.features.lede}</p>
      </div>
      <div class="grid grid--3">
        {
          home.features.items.map((item) => (
            <div class="card">
              <h3>{item.h3}</h3>
              <p>{item.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" id="sports">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.sports.eyebrow}</p>
        <h2>{home.sports.h2}</h2>
        <p>{home.sports.lede}</p>
      </div>
      <div class="grid grid--3">
        {
          home.sports.items.map((item) => (
            <div class="card sport">
              <h3>
                <span class="emoji" aria-hidden="true">{item.emoji}</span> {item.h3}
              </h3>
              <p set:html={item.html} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="guides">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.guides.eyebrow}</p>
        <h2>{home.guides.h2}</h2>
        <p>{home.guides.lede}</p>
      </div>
      <div class="grid grid--3">
        {
          guideCards.map((g) => (
            <a class="guide-card" href={g.path}>
              <img
                class="guide-card__image"
                src={g.featureImage.src}
                alt={g.featureImage.alt}
                width={g.featureImage.width}
                height={g.featureImage.height}
                loading="lazy"
              />
              <span class="eyebrow">{g.tag}</span>
              <h3>{g.cardTitle}</h3>
              <p>{g.cardText}</p>
              <span class="more">Read the guide</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" id="faq">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">FAQ</p>
        <h2>{home.faqTitle}</h2>
      </div>
      <Faq faqs={homeFaqs} />
    </div>
  </section>

  <Cta title={home.cta.title} text={home.cta.text} />
</BaseLayout>
